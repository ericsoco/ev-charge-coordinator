{
  "name": "ev-charge-coordinator",
  "version": "1.0.0",
  "description": "Coordinate EV charging with home solar battery storage",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run lint && npm run typecheck && npm test",
    "clean": "rm -rf dist",
    "check:franklin": "node scripts/run-python-check.mjs"
  },
  "keywords": [
    "ev",
    "charging",
    "tesla",
    "franklinwh",
    "solar",
    "battery"
  ],
  "author": "ericsoco",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "keytar": "^7.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
